{
  "name": "browser-file-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "npm run prepare:curl-wasm && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-dist",
    "postinstall": "npm run prepare:curl-wasm",
    "prepare:curl-wasm": "node scripts/copy-curl-wasm.mjs",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@zxing/browser": "^0.2.1",
    "bwip-js": "^4.11.4",
    "cron-parser": "^5.10.0",
    "curlconverter": "^4.12.0",
    "fflate": "^0.8.3",
    "heic-to": "^1.5.2",
    "js-yaml": "^4.3.1",
    "jsonpath-plus": "10.4.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "sql-formatter": "^15.8.2",
    "svgo": "^4.0.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "@types/papaparse": "^5.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "goodux-ux-skills": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
